<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/bg_secondary">

    <TextView
        android:id="@+id/tv_ach_unlock_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="52sp"
        android:importantForAccessibility="no"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Achievement Unlocked!"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.08"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tv_ach_unlock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tv_ach_unlock_tier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/tier_gold"
        android:layout_marginBottom="14dp"/>

    <View
        android:layout_width="48dp"
        android:layout_height="1dp"
        android:background="@color/accent_secondary"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:id="@+id/tv_ach_unlock_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_ach_unlock_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/accent_gold"/>

</LinearLayout>