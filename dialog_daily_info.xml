<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/bg_secondary">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅"
        android:textSize="52sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tv_daily_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Challenge 1"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="50dp"
        android:layout_height="2dp"
        android:background="@color/accent_gold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A tough 7×7 puzzle with 49 pieces awaits! This is harder than regular levels — take your time."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🪙 Reward: 40 coins on completion"
        android:textSize="13sp"
        android:textColor="@color/accent_gold"
        android:textStyle="bold"/>

</LinearLayout>