<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_secondary"
    android:padding="4dp">

    <!-- Outer decorative border -->
    <View
        android:id="@+id/border_outer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_level_start_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Level label badge at top -->
        <TextView
            android:id="@+id/tv_start_level_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_level_badge"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Thumbnail of the puzzle image -->
        <ImageView
            android:id="@+id/iv_start_thumb"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_level_normal"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/level"/>

        <!-- Coins reward -->
        <TextView
            android:id="@+id/tv_start_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+10 🪙 on completion"
            android:textSize="13sp"
            android:textColor="@color/accent_gold"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Play button — styled like the Candy Crush image -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_play"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Play!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent_secondary"
            app:cornerRadius="26dp"
            app:elevation="6dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>