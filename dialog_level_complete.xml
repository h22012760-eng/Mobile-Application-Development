<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/bg_secondary">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉"
        android:textSize="52sp"
        android:importantForAccessibility="no"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tv_complete_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puzzle Complete!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tv_win_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐⭐⭐"
        android:textSize="28sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tv_win_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Moves: 0   Time: 00:00"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="48dp"
        android:layout_height="1dp"
        android:background="@color/accent_secondary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Coins Earned"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_coins_earned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+10 🪙"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/accent_gold"/>

</LinearLayout>