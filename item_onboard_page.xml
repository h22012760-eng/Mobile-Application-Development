<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboard_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="60dp"
        android:paddingBottom="20dp">

        <!-- Big emoji -->
        <TextView
            android:id="@+id/tv_onboard_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="88sp"
            android:importantForAccessibility="no"
            android:layout_marginBottom="28dp"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_onboard_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp"/>

        <!-- Description -->
        <TextView
            android:id="@+id/tv_onboard_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp"/>

        <!-- Tip card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_secondary"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <TextView
                android:id="@+id/tv_onboard_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/accent_secondary"
                android:gravity="center"
                android:padding="16dp"
                android:lineSpacingExtra="4dp"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>