<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ViewPager fills most of the screen -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboard_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom section: dots + buttons -->
    <LinearLayout
        android:id="@+id/bottom_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="32dp"
        android:paddingTop="16dp"
        android:background="@color/bg_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dots indicator -->
        <LinearLayout
            android:id="@+id/onboard_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Next / Start button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboard_next"
            android:layout_width="240dp"
            android:layout_height="52dp"
            android:text="Next →"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent_secondary"
            app:cornerRadius="26dp"
            android:layout_marginBottom="12dp"/>

        <!-- Skip button -->
        <TextView
            android:id="@+id/btn_onboard_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip Tutorial"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>