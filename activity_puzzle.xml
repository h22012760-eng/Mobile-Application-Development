<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.puzzleverse.game.AuroraBackgroundView
        android:id="@+id/aurora_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/puzzle_ui_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top HUD — wrap_content with minHeight to accommodate window insets -->
        <!-- Refactored to ConstraintLayout to remove nested weights -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hud_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="#EE0D0D1A"
            android:elevation="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:fitsSystemWindows="true"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Coin pill — left, 48dp height minimum -->
            <LinearLayout
                android:id="@+id/coin_pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_aurora_coin_pill"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:contentDescription="@string/coin_balance_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emoji_coin"
                    android:textSize="13sp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/tv_coin_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_cyan"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"/>

            </LinearLayout>

            <!-- Hanging nav — center -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/hanging_nav"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_aurora_nav"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toEndOf="@id/coin_pill"
                app:layout_constraintEnd_toStartOf="@id/btn_back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Moves remaining — left side -->
                <LinearLayout
                    android:id="@+id/moves_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_level_title"
                    app:layout_constraintHorizontal_weight="1">

                    <TextView
                        android:id="@+id/tv_moves_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_moves"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/aurora_cyan"
                        android:fontFamily="monospace"
                        android:importantForAccessibility="yes"
                        android:accessibilityLiveRegion="polite"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/moves_label"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:importantForAccessibility="no"/>

                </LinearLayout>

                <!-- Level title — right side -->
                <TextView
                    android:id="@+id/tv_level_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/level_label_default"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:importantForAccessibility="yes"
                    app:layout_constraintStart_toEndOf="@id/moves_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_weight="1"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- X close button — 48dp minimum touch target -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/symbol_close"
                android:textSize="15sp"
                android:textColor="@color/aurora_cyan"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:contentDescription="@string/desc_close_btn"
                app:backgroundTint="#CC0D0D1A"
                app:strokeColor="@color/cyan_medium"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Moves progress bar -->
        <include
            android:id="@+id/moves_bar"
            layout="@layout/view_moves_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/hud_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Puzzle view — fills ALL remaining space -->
        <com.puzzleverse.game.PuzzleView
            android:id="@+id/puzzle_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/moves_bar"
            app:layout_constraintBottom_toTopOf="@id/bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Bottom bar — wrap_content with minHeight for window insets -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#EE0D0D1A"
            android:elevation="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:fitsSystemWindows="true"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Ghost — 48dp touch target -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ghost"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ghost_btn"
                android:textSize="11sp"
                android:textColor="@color/aurora_cyan"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/desc_ghost_btn"
                app:backgroundTint="#CC0D0D1A"
                app:strokeColor="@color/cyan_soft"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                android:layout_marginEnd="4dp"/>

            <!-- Peek — 48dp + explicit contentDescription fixes accessibility -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_peek"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/peek_button_text"
                android:textSize="11sp"
                android:textColor="@color/aurora_cyan"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/desc_peek_btn"
                app:backgroundTint="#CC0D0D1A"
                app:strokeColor="@color/cyan_soft"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                android:layout_marginEnd="4dp"/>

            <!-- Scramble — 48dp touch target -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scramble"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/scramble_btn_label"
                android:textSize="11sp"
                android:textColor="@color/aurora_cyan"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/desc_scramble_btn"
                app:backgroundTint="#CC0D0D1A"
                app:strokeColor="@color/cyan_soft"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
