<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.puzzleverse.game.AuroraBackgroundView
        android:id="@+id/aurora_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#CC0B0C10"
            android:elevation="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="✕"
                android:textSize="14sp"
                android:textColor="@color/aurora_cyan"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="#CC0F1923"
                app:strokeColor="@color/aurora_cyan"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                android:contentDescription="@string/content_desc_back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/aurora_cyan"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_aurora_coin_pill"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:contentDescription="@string/coin_balance_desc">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emoji_coin"
                    android:textSize="13sp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/tv_coin_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_gold"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"/>

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Audio section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_audio"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_cyan"
                    android:layout_marginBottom="10dp"/>

                <!-- Sound row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sound"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/aurora_text_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sound_desc"
                            android:textSize="12sp"
                            android:textColor="@color/aurora_text_secondary"/>

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_sound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/aurora_cyan"
                        app:trackTint="#1F2833"/>

                </LinearLayout>

                <!-- Music row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/music"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/aurora_text_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/music_desc"
                            android:textSize="12sp"
                            android:textColor="@color/aurora_text_secondary"/>

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_music"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/aurora_cyan"
                        app:trackTint="#1F2833"/>

                </LinearLayout>

                <!-- Haptics section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_haptics"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_cyan"
                    android:layout_marginBottom="10dp"/>

                <!-- Vibration row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vibration"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/aurora_text_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vibration_desc"
                            android:textSize="12sp"
                            android:textColor="@color/aurora_text_secondary"/>

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_vibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/aurora_cyan"
                        app:trackTint="#1F2833"/>

                </LinearLayout>

                <!-- Coins section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_coins"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_cyan"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="18dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tv_current_coins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/current_coins_placeholder"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/aurora_cyan"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coins_info_desc"
                        android:textSize="13sp"
                        android:textColor="@color/aurora_text_secondary"
                        android:lineSpacingExtra="3dp"/>

                </LinearLayout>

                <!-- Gameplay section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮  Gameplay"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_cyan"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mystery Mode"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/aurora_text_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Image reveals as you place pieces"
                            android:textSize="12sp"
                            android:textColor="@color/aurora_text_secondary"/>

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_mystery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="@color/aurora_cyan"
                        app:trackTint="#1F2833"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_version_full"
                    android:textSize="12sp"
                    android:textColor="@color/aurora_text_hint"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"/>

                <!-- Reset progress section -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1F2833"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_progress"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Reset All Progress"
                    android:textSize="14sp"
                    android:textColor="#F87171"
                    app:backgroundTint="#CC0F1923"
                    app:strokeColor="#F87171"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="32dp"/>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>