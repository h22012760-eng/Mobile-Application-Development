<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PuzzleVerse">

        <!-- Splash is the entry point -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PuzzleVerse.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- MainActivity — singleTask ensures only one instance ever exists -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"/>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"/>

        <activity
            android:name=".LevelSelectActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"/>

        <!-- PuzzleActivity — standard so each level is a fresh instance -->
        <activity
            android:name=".PuzzleActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="standard"/>

        <!-- WinActivity — standard, always fresh -->
        <activity
            android:name=".WinActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="standard"/>

        <activity
            android:name=".DailyChallengeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"/>

        <activity
            android:name=".AchievementsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"/>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>
</manifest>